<?xml version="1.0" encoding="utf-8"?>
<!-- Root element is <Patch>, singular. <Patches> silently discards every
     operation in the file. -->
<Patch>

  <!-- Ownership and a work type for the VANILLA outfit stand, rather than a
       stand of our own. A new ThingDef would need either new art — which is
       exactly what this mod exists not to ship — or a copy of the vanilla
       texture, giving the player two identical-looking buildings in the
       architect menu. Adding to the vanilla def also means existing stands in
       existing saves gain the gizmo on load, with nothing to rebuild.

       An unassigned stand is untouched by all of this and behaves exactly as
       it does in vanilla.

       TWO operations, because this def is a commons. The vanilla def ships
       without a <comps> node, but other mods add one — Outfit Stands Plus
       puts its own comps on this exact def — and a def that ends up with two
       <comps> nodes does not merge them: the loader logs "defines the same
       field twice" and keeps the LAST node (DirectXmlToObject.cs:183-199,
       verified 1.6.4871), silently deleting the other mod's comps. So: make
       sure the node exists, then append into it. Composes identically in
       either load order. (Found the hard way against Outfit Stands Plus,
       2026-08-18 — the blind-Add version deleted their comps whenever they
       loaded first.)

       Each operation is guarded on the def existing so the whole file is a
       no-op without Odyssey (the stand is Odyssey content) instead of
       logging a failed xpath. -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="Building_OutfitStand"]</xpath>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="Building_OutfitStand"]/comps</xpath>
      <nomatch Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="Building_OutfitStand"]</xpath>
        <value>
          <comps />
        </value>
      </nomatch>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="Building_OutfitStand"]/comps</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="Building_OutfitStand"]/comps</xpath>
      <value>
        <li Class="ShiftChange.CompProperties_ShiftStand" />
        <li Class="CompProperties_AssignableToPawn">
          <compClass>ShiftChange.CompAssignableToPawn_ShiftStand</compClass>
          <!-- The overlay is how a room of pool stands is read at a glance:
               our comp draws the current BORROWER's name when one is out,
               and falls back to the base's owner name otherwise. Unowned
               stays off so a shelf of idle stands is not a wall of
               "Unowned". -->
          <drawAssignmentOverlay>true</drawAssignmentOverlay>
          <drawUnownedAssignmentOverlay>false</drawUnownedAssignmentOverlay>
        </li>
      </value>
    </match>
  </Operation>

</Patch>
