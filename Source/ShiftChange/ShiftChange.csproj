<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shift Change's only assembly. RimWorld is .NET Framework 4.7.2. Game
       references resolve below, either from a local install or from
       Krafs.Rimworld.Ref; Harmony comes from Lib.Harmony. All package
       references are compile-time only, because RimWorld loads every DLL it
       finds in Assemblies/ and Harmony ships as its own mod
       (brrainz.harmony). -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ShiftChange</RootNamespace>
    <AssemblyName>ShiftChange</AssemblyName>
    <Version>0.0.1</Version>

    <!-- Straight into the mod's load path, no framework subfolder, no pdb —
         the game cannot read one, and stack traces stay useful through
         Harmony's own annotations. -->
    <OutputPath>../../Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.*" ExcludeAssets="runtime" />
    <!-- net472 reference assemblies, so this builds on a machine with only
         the modern dotnet SDK (this one is a Mac; there is no Framework
         targeting pack outside the package). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Game references, two modes, one committed file (same pattern as Fine
       Establishments).

       A machine with a RimWorld install compiles against the REAL game
       assemblies, in every configuration. A machine without one (CI, a fresh
       clone) falls back to Krafs.Rimworld.Ref. Identical public surface; the
       difference is that reference assemblies carry signatures and no IL, so
       only the real DLLs let go-to-definition decompile engine bodies.

       The gate used to be Configuration == Debug. That broke F12 in practice:
       the rule is to end every Debug session with a Release build (it sweeps
       the hot-reload artifacts), which left the editor's design-time build
       resolving Krafs, so navigation landed on empty stubs until someone
       rebuilt Debug. Keying on install presence instead removes the conflict.

       Reproducibility: CI has no game install, so it always builds against
       Krafs, and the release job rebuilds before packaging — the GitHub release
       zip is always the Krafs build. The Workshop upload is staged from a local
       Release build, so it carries whichever references that machine resolved.
       To reproduce CI
       locally, pass -p:DisableLocalGameRefs=true. Non-standard install: set
       RimWorldManaged (env var or -p:). The Odyssey outfit-stand code needs no
       extra reference — DLC types ship inside Assembly-CSharp. -->
  <PropertyGroup>
    <RimWorldManaged Condition="'$(RimWorldManaged)' == '' AND Exists('$(HOME)/Library/Application Support/Steam/steamapps/common/RimWorld/RimWorldMac.app/Contents/Resources/Data/Managed')">$(HOME)/Library/Application Support/Steam/steamapps/common/RimWorld/RimWorldMac.app/Contents/Resources/Data/Managed</RimWorldManaged>
    <RimWorldManaged Condition="'$(RimWorldManaged)' == '' AND Exists('C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed')">C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
    <RimWorldManaged Condition="'$(RimWorldManaged)' == '' AND Exists('$(HOME)/.steam/steam/steamapps/common/RimWorld/RimWorldLinux_Data/Managed')">$(HOME)/.steam/steam/steamapps/common/RimWorld/RimWorldLinux_Data/Managed</RimWorldManaged>
    <LocalGameRefs Condition="'$(RimWorldManaged)' != '' AND '$(DisableLocalGameRefs)' != 'true'">true</LocalGameRefs>
  </PropertyGroup>

  <ItemGroup Condition="'$(LocalGameRefs)' != 'true'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Condition="'$(LocalGameRefs)' == 'true'">
    <!-- Private=false is this group's ExcludeAssets: compile-time only. The
         Debug-only CopyLocalLockFileAssemblies below moves NuGet assets (the
         ECR runtime), never these direct references. -->
    <Reference Include="$(RimWorldManaged)/Assembly-CSharp.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(RimWorldManaged)/UnityEngine.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(RimWorldManaged)/UnityEngine.*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Hot reload (ECR, Zetrith's EditCompileReload) — DEV ONLY. Debug builds
       instrument the assembly and watch for recompiles, so a layout tweak
       shows in the running game without a restart; Release never references
       any of it. The library must sit beside our dll at runtime, hence the
       Debug-only copy override (the global default is false because
       Assemblies/ must ship only our dll — Krafs/Harmony stay excluded
       regardless). -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="EditCompileReload" Version="1.0.2" />
    <PackageReference Include="EditCompileReload.CompilerPlugin" Version="1.0.2" PrivateAssets="all" />
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- The Release build is the choke point that sweeps dev artifacts out of
       the mod's load path — same philosophy as the FE texture generator
       deleting stale .dds at the write site. Hygiene by construction, not by
       memory: whatever a Debug session dropped in (the ECR runtime, its
       dependencies, the instrumented-original copy), a Release build removes,
       leaving exactly the one dll the mod ships. -->
  <Target Name="CleanDevArtifacts" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <DevJunk Include="$(OutputPath)*.dll" Exclude="$(OutputPath)$(AssemblyName).dll" />
      <DevJunk Include="$(OutputPath)*.dll_orig" />
      <DevJunk Include="$(OutputPath)*.pdb" />
    </ItemGroup>
    <Delete Files="@(DevJunk)" />
  </Target>

</Project>
