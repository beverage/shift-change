# macOS
.DS_Store

# Build artifact of devtools/bbcode-preview.py, written beside its source.
_bbcode-preview.html

# Card pipeline intermediates, all rebuilt from tracked inputs:
#   media/cards/parts/    cut from cards/card-*.png and cards/src/ by card-crops.sh
#   media/cards/_export/  one page per card, written by card-mockup.py --export
#   media/_*.html         local previews of the page and of single sections
# The finished PNGs in media/cards/ ARE tracked, and have to be: the Steam
# description reaches them by raw.githubusercontent URL, so they exist on main
# or the store page renders broken images.
media/cards/parts/
media/cards/_export/
media/_card-mockup.html
media/_card-section.html
media/_page.html

# Editor state
.vscode/

# Agent instructions are shared in AGENTS.md, which is vendor-neutral and
# checked in. Assistant-specific files import it and add whatever is local to
# one working copy, so they stay untracked.
CLAUDE.md
CLAUDE.local.md
.cursorrules
.cursor/
.github/copilot-instructions.md

# C# build output
obj/
bin/

# Python bytecode from the devtools scripts
__pycache__/

# Staging area for the Workshop upload (devtools/publish-workshop.sh) and the
# CI release zip. Assembled from tracked files, never edited in place.
dist/

# Parked copies of this machine's RimWorld mod list
# (devtools/rimworld-profile.sh). Personal and machine-specific; the minimal
# test profile that matters is defined in the script itself.
devtools/profiles/

# RimWorld's texture cache. The game never writes these itself, but tools on
# this machine do (FasterGameLoading-Continued, RimPy, RimSort) — and a .dds
# beside a PNG makes the game ignore the PNG entirely, with no timestamp check.
# Shift Change ships no textures today; the rule is here so it cannot start.
*.dds

# Hot-reload dev artifacts (ECR). Debug builds drop the reloader runtime, its
# dependencies and an instrumented-original copy beside our dll; the Release
# build sweeps them. Only our own assembly is ever tracked.
Assemblies/*
!Assemblies/ShiftChange.dll
