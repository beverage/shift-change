<?xml version="1.0" encoding="utf-8"?>
<!-- This file owns ALL folder resolution once it exists: the "/" entries are
     what load the mod at all. Tests/ holds the DevTools tests, a separate
     assembly the game loads only while DevTools is active, and DevTools is
     1.7 only. Both ship: a player without DevTools loads the root alone,
     as if neither were there, and installing DevTools is the opt-in.
     devtools/check-shipped-tests.py checks this file in every copy that
     ships. -->
<loadFolders>
  <v1.6>
    <li>/</li>
  </v1.6>
  <v1.7>
    <li>/</li>
    <li IfModActive="SmashPhil.DevTools">Tests</li>
  </v1.7>
</loadFolders>
